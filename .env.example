# SmartShop — Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your Gemini API key.
# The app works fully WITHOUT a key (uses the built-in local parser).
#
# Get your free API key at: https://aistudio.google.com/app/apikey
# Model in use: gemini-flash-lite-latest
#
# SECURITY: .env is in .gitignore and will NEVER be committed to Git.
# ─────────────────────────────────────────────────────────────────

GEMINI_API_KEY=your_gemini_api_key_here
